APP_NAME="SI-MELAYUR"
GOOGLE_SERVICE_ACCOUNT_PATH=storage/app/private/google/si-melayur-sheets-reader.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RESPONSE_RANGE="'Form Responses 1'!A:Z"
GOOGLE_SHEETS_PHONE_COLUMN="Nomor Telepon"
GOOGLE_SHEETS_TIMESTAMP_COLUMN=Timestamp
GOOGLE_SHEETS_TIMEZONE=Asia/Jakarta
GOOGLE_SHEETS_TIMESTAMP_FORMAT="d/m/Y H:i:s"
GOOGLE_GUESTBOOK_FORM_URL=
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Groq LLM answer generation. Leave disabled to use deterministic grounded answers.
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=15
GROQ_MAX_COMPLETION_TOKENS=1800

# WhatsApp Cloud API (Meta). Tidak menggunakan QR/WhatsApp Web.
WHATSAPP_NOTIFICATIONS_ENABLED=false
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_RECIPIENT=628xxxxxxxxxx
WHATSAPP_TEMPLATE_NAME=simolek_unanswered_question
WHATSAPP_TEMPLATE_LANGUAGE=id

# Opsional: tombol kontak layanan resmi yang terlihat oleh pengguna.
DKP_CONTACT_WHATSAPP_URL=

# Server-to-server attendance API (SHA-256 token digests, never raw tokens).
SI_MELAYUR_ATTENDANCE_TOKEN_HASH=
SI_MELAYUR_ATTENDANCE_PREVIOUS_TOKEN_HASH=
SI_MELAYUR_ATTENDANCE_CAN_VERIFY=false

# Enable external AI only after the institution confirms its Groq Free Plan.
# Bind that confirmation to the institution's key using its SHA-256 fingerprint.
GROQ_ACCOUNT_OWNER=unset
GROQ_FREE_PLAN_CONFIRMED=false
GROQ_FREE_PLAN_KEY_SHA256=
CHATBOT_GUEST_PER_MINUTE=5
CHATBOT_GUEST_PER_DAY=30
CHATBOT_ACCOUNT_PER_MINUTE=10
CHATBOT_ACCOUNT_PER_DAY=100
CHATBOT_IP_PER_MINUTE=60
CHATBOT_IP_PER_DAY=500
GROQ_REQUESTS_PER_MINUTE=24
GROQ_REQUESTS_PER_DAY=800
GROQ_TOKENS_PER_MINUTE=6400
GROQ_TOKENS_PER_DAY=160000
GROQ_MAX_PROMPT_BYTES=4000
GROQ_ANSWER_CACHE_SECONDS=900
